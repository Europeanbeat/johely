    "embla-carousel-wheel-gestures": "^8.1.0",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
